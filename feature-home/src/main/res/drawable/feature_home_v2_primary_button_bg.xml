<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="@color/feature_home_v2_green_track" />
            <corners android:radius="@dimen/feature_home_v2_button_radius" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/feature_home_v2_green_pressed" />
            <corners android:radius="@dimen/feature_home_v2_button_radius" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="0"
                android:centerColor="#33D598"
                android:centerX="0.5"
                android:endColor="#35D49A"
                android:startColor="#36D49B"
                android:type="linear" />
            <corners android:radius="@dimen/feature_home_v2_button_radius" />
        </shape>
    </item>
</selector>
