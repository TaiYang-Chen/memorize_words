<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/feature_learning_done_surface_pressed" />
            <stroke
                android:width="@dimen/core_ui_dp_1"
                android:color="@color/feature_learning_done_outline" />
            <corners android:radius="@dimen/core_ui_dp_12" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/feature_learning_done_white" />
            <stroke
                android:width="@dimen/core_ui_dp_1"
                android:color="@color/feature_learning_done_outline" />
            <corners android:radius="@dimen/core_ui_dp_12" />
        </shape>
    </item>
</selector>
