<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="viewModel"
            type="com.chen.memorizewords.feature.learning.ui.done.LearningDoneViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/feature_learning_done_navy">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topBar"
            android:layout_width="0dp"
            android:layout_height="@dimen/core_ui_dp_32"
            android:layout_marginStart="@dimen/page_margin"
            android:layout_marginTop="@dimen/title_margin"
            android:layout_marginEnd="@dimen/page_margin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivClose"
                android:layout_width="@dimen/core_ui_dp_32"
                android:layout_height="@dimen/core_ui_dp_32"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:onClick="@{() -> viewModel.finish()}"
                android:padding="@dimen/core_ui_dp_6"
                android:src="@drawable/module_learning_close"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/feature_learning_done_white" />

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/core_ui_dp_12"
                android:layout_marginEnd="@dimen/core_ui_dp_12"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/learning_done_header_title"
                android:textColor="@color/feature_learning_done_white"
                android:textSize="@dimen/core_ui_text_18"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/ivShare"
                app:layout_constraintStart_toEndOf="@id/ivClose"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/ivShare"
                android:layout_width="@dimen/core_ui_dp_32"
                android:layout_height="@dimen/core_ui_dp_32"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="@dimen/core_ui_dp_5"
                android:src="@drawable/module_learning_share_24dp_444f5f"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/feature_learning_done_white" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nestedScrollView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/feature_learning_done_white"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingBottom="@dimen/core_ui_dp_142"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topBar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/feature_learning_done_white"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/cardHero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/feature_learning_done_navy"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/core_ui_dp_20"
                    android:paddingTop="@dimen/core_ui_dp_12"
                    android:paddingEnd="@dimen/core_ui_dp_20"
                    android:paddingBottom="@dimen/core_ui_dp_12">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/core_ui_dp_52"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="@dimen/core_ui_dp_28"
                            android:layout_height="@dimen/core_ui_dp_1"
                            android:layout_marginEnd="@dimen/core_ui_dp_10"
                            android:background="@color/feature_learning_done_gold_stroke" />

                        <FrameLayout
                            android:layout_width="@dimen/core_ui_dp_52"
                            android:layout_height="@dimen/core_ui_dp_52"
                            android:background="@drawable/feature_learning_bg_done_honor_medal_outer">

                            <FrameLayout
                                android:layout_width="@dimen/core_ui_dp_40"
                                android:layout_height="@dimen/core_ui_dp_40"
                                android:layout_gravity="center"
                                android:background="@drawable/feature_learning_bg_done_honor_medal_inner">

                                <ImageView
                                    android:layout_width="@dimen/core_ui_dp_26"
                                    android:layout_height="@dimen/core_ui_dp_26"
                                    android:layout_gravity="center"
                                    android:src="@drawable/module_learning_ic_summary_medal" />
                            </FrameLayout>
                        </FrameLayout>

                        <View
                            android:layout_width="@dimen/core_ui_dp_28"
                            android:layout_height="@dimen/core_ui_dp_1"
                            android:layout_marginStart="@dimen/core_ui_dp_10"
                            android:background="@color/feature_learning_done_gold_stroke" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDoneTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/core_ui_dp_8"
                        android:background="@drawable/feature_learning_bg_done_honor_chip"
                        android:includeFontPadding="false"
                        android:paddingStart="@dimen/core_ui_dp_14"
                        android:paddingTop="@dimen/core_ui_dp_6"
                        android:paddingEnd="@dimen/core_ui_dp_14"
                        android:paddingBottom="@dimen/core_ui_dp_6"
                        android:text="@string/learning_done_tag_new"
                        android:textColor="@color/feature_learning_done_orange_text"
                        android:textSize="@dimen/core_ui_text_14"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDoneTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/core_ui_dp_10"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/learning_done_title"
                        android:textColor="@color/feature_learning_done_white"
                        android:textSize="@dimen/core_ui_text_28"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDoneSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/core_ui_dp_8"
                        android:gravity="center"
                        android:lineSpacingExtra="@dimen/core_ui_dp_2"
                        android:maxLines="2"
                        android:text="@string/learning_done_subtitle_new"
                        android:textColor="@color/feature_learning_done_header_secondary"
                        android:textSize="@dimen/core_ui_text_13" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardStats"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/core_ui_dp_76"
                    android:background="@color/feature_learning_done_navy"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/core_ui_dp_12"
                    android:paddingEnd="@dimen/core_ui_dp_12">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvMetricCompletedValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="0"
                            android:textColor="@color/feature_learning_done_white"
                            android:textSize="@dimen/core_ui_text_22"
                            android:textStyle="bold"
                            app:autoSizeMaxTextSize="22sp"
                            app:autoSizeMinTextSize="14sp"
                            app:autoSizeStepGranularity="1sp"
                            app:autoSizeTextType="uniform"
                            tools:text="11" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/core_ui_dp_7"
                            android:includeFontPadding="false"
                            android:text="@string/learning_done_metric_completed"
                            android:textColor="@color/feature_learning_done_header_secondary"
                            android:textSize="@dimen/core_ui_text_12" />
                    </LinearLayout>

                    <View
                        android:layout_width="@dimen/core_ui_dp_1"
                        android:layout_height="@dimen/core_ui_dp_46"
                        android:background="@color/feature_learning_done_header_divider" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvMetricAccuracyValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="0%"
                            android:textColor="@color/feature_learning_done_white"
                            android:textSize="@dimen/core_ui_text_22"
                            android:textStyle="bold"
                            app:autoSizeMaxTextSize="22sp"
                            app:autoSizeMinTextSize="14sp"
                            app:autoSizeStepGranularity="1sp"
                            app:autoSizeTextType="uniform"
                            tools:text="100%" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/core_ui_dp_7"
                            android:includeFontPadding="false"
                            android:text="@string/learning_done_metric_accuracy"
                            android:textColor="@color/feature_learning_done_header_secondary"
                            android:textSize="@dimen/core_ui_text_12" />
                    </LinearLayout>

                    <View
                        android:layout_width="@dimen/core_ui_dp_1"
                        android:layout_height="@dimen/core_ui_dp_46"
                        android:background="@color/feature_learning_done_header_divider" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvMetricDurationValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="0 m"
                            android:textColor="@color/feature_learning_done_white"
                            android:textSize="@dimen/core_ui_text_22"
                            android:textStyle="bold"
                            app:autoSizeMaxTextSize="22sp"
                            app:autoSizeMinTextSize="14sp"
                            app:autoSizeStepGranularity="1sp"
                            app:autoSizeTextType="uniform"
                            tools:text="0 m" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/core_ui_dp_7"
                            android:includeFontPadding="false"
                            android:text="@string/learning_done_metric_duration"
                            android:textColor="@color/feature_learning_done_header_secondary"
                            android:textSize="@dimen/core_ui_text_12" />
                    </LinearLayout>

                    <View
                        android:layout_width="@dimen/core_ui_dp_1"
                        android:layout_height="@dimen/core_ui_dp_46"
                        android:background="@color/feature_learning_done_header_divider" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvMetricQualityValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="A"
                            android:textColor="@color/feature_learning_done_white"
                            android:textSize="@dimen/core_ui_text_22"
                            android:textStyle="bold"
                            app:autoSizeMaxTextSize="22sp"
                            app:autoSizeMinTextSize="14sp"
                            app:autoSizeStepGranularity="1sp"
                            app:autoSizeTextType="uniform"
                            tools:text="A" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/core_ui_dp_7"
                            android:includeFontPadding="false"
                            android:text="@string/learning_done_metric_quality"
                            android:textColor="@color/feature_learning_done_header_secondary"
                            android:textSize="@dimen/core_ui_text_12" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/feature_learning_done_white"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/page_margin"
                    android:paddingEnd="@dimen/page_margin"
                    android:paddingBottom="@dimen/core_ui_dp_24">

                    <LinearLayout
                        android:id="@+id/cardExtraStats"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/core_ui_dp_82"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/core_ui_dp_4"
                        android:paddingEnd="@dimen/core_ui_dp_4">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:text="@string/learning_done_metric_answered"
                                android:textColor="@color/feature_learning_done_text_secondary"
                                android:textSize="@dimen/core_ui_text_14" />

                            <TextView
                                android:id="@+id/tvMetricAnsweredValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/core_ui_dp_8"
                                android:includeFontPadding="false"
                                android:text="0"
                                android:textColor="@color/feature_learning_done_text_primary"
                                android:textSize="@dimen/core_ui_text_16"
                                android:textStyle="bold"
                                tools:text="1" />
                        </LinearLayout>

                        <View
                            android:layout_width="@dimen/core_ui_dp_1"
                            android:layout_height="@dimen/core_ui_dp_50"
                            android:background="@color/feature_learning_done_divider" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:text="@string/learning_done_metric_wrong"
                                android:textColor="@color/feature_learning_done_text_secondary"
                                android:textSize="@dimen/core_ui_text_14" />

                            <TextView
                                android:id="@+id/tvMetricWrongValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/core_ui_dp_8"
                                android:includeFontPadding="false"
                                android:text="0"
                                android:textColor="@color/feature_learning_done_wrong"
                                android:textSize="@dimen/core_ui_text_16"
                                android:textStyle="bold"
                                tools:text="0" />
                        </LinearLayout>

                        <View
                            android:layout_width="@dimen/core_ui_dp_1"
                            android:layout_height="@dimen/core_ui_dp_50"
                            android:background="@color/feature_learning_done_divider" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:text="@string/learning_done_metric_efficiency"
                                android:textColor="@color/feature_learning_done_text_secondary"
                                android:textSize="@dimen/core_ui_text_14" />

                            <TextView
                                android:id="@+id/tvMetricEfficiencyValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/core_ui_dp_8"
                                android:ellipsize="end"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:text="0.0"
                                android:textColor="@color/feature_learning_done_text_primary"
                                android:textSize="@dimen/core_ui_text_15"
                                android:textStyle="bold"
                                app:autoSizeMaxTextSize="15sp"
                                app:autoSizeMinTextSize="12sp"
                                app:autoSizeStepGranularity="1sp"
                                app:autoSizeTextType="uniform"
                                tools:text="11.0 词/分" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/core_ui_dp_1"
                        android:background="@color/feature_learning_done_divider" />

                    <TextView
                        android:id="@+id/tvWordListTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/core_ui_dp_18"
                        android:includeFontPadding="false"
                        android:text="@string/learning_done_list_title"
                        android:textColor="@color/feature_learning_done_text_primary"
                        android:textSize="@dimen/core_ui_text_20"
                        android:textStyle="bold" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvWordList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/core_ui_dp_12"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        tools:itemCount="2"
                        tools:listitem="@layout/rv_item_word_list" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/actionPanel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/feature_learning_bg_done_honor_action_panel"
            android:elevation="@dimen/core_ui_dp_8"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_margin"
            android:paddingTop="@dimen/core_ui_dp_8"
            android:paddingEnd="@dimen/page_margin"
            android:paddingBottom="@dimen/core_ui_dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/btnBackHome"
                android:layout_width="match_parent"
                android:layout_height="@dimen/core_ui_dp_48"
                android:background="@drawable/feature_learning_selector_done_honor_secondary"
                android:gravity="center"
                android:text="@string/learning_done_back_home"
                android:textColor="@color/feature_learning_done_orange_text"
                android:textSize="@dimen/core_ui_text_18"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnContinue"
                android:layout_width="match_parent"
                android:layout_height="@dimen/core_ui_dp_48"
                android:layout_marginTop="@dimen/core_ui_dp_10"
                android:background="@drawable/feature_learning_selector_done_honor_primary"
                android:gravity="center"
                android:text="@string/learning_done_continue"
                android:textColor="@color/feature_learning_done_white"
                android:textSize="@dimen/core_ui_text_18"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
